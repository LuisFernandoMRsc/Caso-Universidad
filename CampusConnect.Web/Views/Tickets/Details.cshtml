@model CampusConnect.Web.Models.Entities.Ticket

@{
    ViewData["Title"] = "Detalles de Solicitud #" + Model.Id;
    var technicians = ViewBag.Technicians as List<CampusConnect.Web.Models.Entities.User> ?? new List<CampusConnect.Web.Models.Entities.User>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Volver a la lista</a>
        <div>
            <span class="badge bg-primary fs-6">Ticket #@Model.Id</span>
        </div>
    </div>

    <div class="row">
        <!-- Columna de Detalles y Gestión -->
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Model.Title</h5>
                    <span class="badge bg-warning text-dark">@Model.Status</span>
                </div>
                <div class="card-body">
                    <p class="card-text fs-5">@Model.Description</p>
                    <hr />
                    <div class="row text-muted">
                        <div class="col-md-6">
                            <strong>Estudiante solicitante:</strong> @Model.Student?.Name (@Model.Student?.Email)<br />
                            <strong>Recurso afectado:</strong> @(Model.Resource != null ? Model.Resource.Name : "Ninguno específico")
                        </div>
                        <div class="col-md-6">
                            <strong>Tipo de Incidencia:</strong> @Model.Type<br />
                            <strong>Prioridad:</strong> @Model.Priority<br />
                            <strong>Fecha de Registro:</strong> @Model.CreatedAt.ToString("g")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Trazabilidad y Comentarios -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Historial de Trazabilidad & Comentarios</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Comments.Any())
                    {
                        <p class="text-muted">No hay comentarios ni actualizaciones registradas aún.</p>
                    }
                    else
                    {
                        <div class="list-group mb-3">
                            @foreach (var c in Model.Comments.OrderBy(x => x.CreatedAt))
                            {
                                <div class="list-group-item list-group-item-action flex-column align-items-start mb-2 border rounded">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1 text-primary fw-bold">@c.User?.Name <span class="badge bg-light text-dark border">@c.User?.Role</span></h6>
                                        <small class="text-muted">@c.CreatedAt.ToString("g")</small>
                                    </div>
                                    <p class="mb-1">@c.CommentText</p>
                                </div>
                            }
                        </div>
                    }

                    <form asp-action="AddComment" method="post" class="mt-3">
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <div class="mb-2">
                            <label class="form-label fw-bold">Agregar nuevo avance o comentario:</label>
                            <textarea name="commentText" class="form-control" rows="3" placeholder="Escribe aquí el avance de la atención..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Publicar Comentario</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Columna de Asignación y Estado -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Acciones de Atención</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Asignar Responsable</label>
                            <select name="assignedSupportId" class="form-select">
                                <option value="">-- Sin Asignar --</option>
                                @foreach (var tech in technicians)
                                {
                                    <option value="@tech.Id" selected="@(Model.AssignedSupportId == tech.Id)">
                                        @tech.Name (@tech.Role)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Cambiar Estado</label>
                            <select name="status" class="form-select">
                                <option value="Pendiente" selected="@(Model.Status == "Pendiente")">Pendiente</option>
                                <option value="En Proceso" selected="@(Model.Status == "En Proceso")">En Proceso</option>
                                <option value="Resuelta" selected="@(Model.Status == "Resuelta")">Resuelta</option>
                                <option value="Cerrada" selected="@(Model.Status == "Cerrada")">Cerrada</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Guardar Cambios</button>
                    </form>
                </div>
            </div>

            <!-- Evidencias Adjuntas -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Evidencias Adjuntas</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Evidences.Any())
                    {
                        <p class="text-muted small">No se adjuntaron fotografías ni evidencias para esta solicitud.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled">
                            @foreach (var ev in Model.Evidences)
                            {
                                <li>
                                    <a href="@ev.FilePath" target="_blank" class="btn btn-outline-info btn-sm w-100 mb-2">
                                        <i class="bi bi-file-earmark-image"></i> Ver Evidencia (#@ev.Id)
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
