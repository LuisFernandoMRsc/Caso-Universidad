@model IEnumerable<CampusConnect.Web.Models.Entities.Ticket>

@{
    ViewData["Title"] = "Gestión de Solicitudes";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-card-checklist"></i> Bandeja de Solicitudes Estudiantiles</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Solicitudes Registradas para Atención</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Tipo</th>
                            <th>Prioridad</th>
                            <th>Estado</th>
                            <th>Estudiante</th>
                            <th>Responsable</th>
                            <th>Fecha</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">No hay solicitudes pendientes en este momento.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>#@item.Id</td>
                                    <td class="fw-bold">@item.Title</td>
                                    <td><span class="badge bg-secondary">@item.Type</span></td>
                                    <td>
                                        @if (item.Priority == "Alta" || item.Priority == "Urgente")
                                        {
                                            <span class="badge bg-danger">@item.Priority</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@item.Priority</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == "Pendiente")
                                        {
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        }
                                        else if (item.Status == "En Proceso")
                                        {
                                            <span class="badge bg-info text-dark">En Proceso</span>
                                        }
                                        else if (item.Status == "Resuelta")
                                        {
                                            <span class="badge bg-success">Resuelta</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Cerrada</span>
                                        }
                                    </td>
                                    <td>@item.Student?.Name</td>
                                    <td>@(item.AssignedSupport != null ? item.AssignedSupport.Name : "Sin asignar")</td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Atender / Ver Trazabilidad</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
